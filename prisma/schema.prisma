// Overboard Organizer schema
// User accounts are isolated by default. Projects can be shared via ProjectShare.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Lane {
  BACKLOG
  TODO
  DOING
  DONE
  FAILED
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  createdAt        DateTime @default(now())
  failedWindowDays Int      @default(7)

  sessions       Session[]
  projects       Project[]
  ideas          Idea[]
  tokens         Token[]
  tags           Tag[]
  axes           Axis[]
  components     Component[]
  classes        ProjectClass[]
  classLinks     ProjectClassLink[]
  sharedProjects ProjectShare[] @relation("sharedProjects")
  assignedCards  Card[]         @relation("assignedCards")
}

// A reusable named schedule ("class") that marks a project active/inactive by
// hour. The built-in "Omnipresent" flag lives directly on Project/ProjectShare
// (`omnipresent`) and isn't backed by a row here. `windows` is a JSON-encoded
// ScheduleWindow[] (see src/lib/board/schedule.ts for the shape/validation).
model ProjectClass {
  id        String   @id @default(cuid())
  userId    String
  name      String
  tz        String // IANA zone
  windows   String // JSON array of ScheduleWindow
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  links ProjectClassLink[]

  @@unique([userId, name])
  @@index([userId])
}

// A viewer's assignment of a project to a class. `userId` is the viewer this
// assignment belongs to: the owner for their own Project, or a shared
// viewer for their ProjectShare (mirrors how scheduleMode/priority are
// per-viewer). A project is active if omnipresent OR any linked class is
// currently active ("any-of"); no links and omnipresent=false means out of
// mind.
model ProjectClassLink {
  projectId String
  userId    String
  classId   String

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  class   ProjectClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([projectId, userId, classId])
  @@index([userId])
  @@index([classId])
}

model Token {
  id         String    @id @default(cuid())
  userId     String
  hash       String    @unique
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  priority    Int      @default(1) // lower = higher in list; can be 0 or negative
  archived    Boolean  @default(false)
  omnipresent Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  classLinks ProjectClassLink[]
  cards      Card[]
  shares     ProjectShare[]

  @@index([userId])
  @@index([userId, priority])
}

model Card {
  id          String    @id @default(cuid())
  projectId   String
  lane        Lane
  order       Int
  title       String
  contentJson String? // ProseMirror JSON from TipTap
  contentMd   String? // Markdown export
  assigneeId  String?
  dueAt       DateTime?
  expires     Boolean   @default(false)
  failedAt    DateTime?
  rescuedAt   DateTime?
  doneAt      DateTime?
  recurrence  String?
  seriesId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?    @relation("assignedCards", fields: [assigneeId], references: [id], onDelete: SetNull)
  tags     CardTag[]

  @@index([projectId])
  @@index([projectId, lane, order])
  @@index([assigneeId])
  @@index([dueAt])
}

model Idea {
  id          String   @id @default(cuid())
  userId      String
  order       Int
  title       String
  contentJson String?
  contentMd   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags       IdeaTag[]
  axes       ConceptAxis[]
  components ConceptComponent[]

  @@index([userId])
  @@index([userId, order])
}

// --- Components -----------------------------------------------------------
// An Idea is a "concept" in UI copy. A concept is decomposed into components
// grouped under axes. The load-bearing property is that components are
// *referenced, not contained*: `social deduction` attached to two concepts is
// one Component row seen twice, which is what makes overlap computable at all.
// This is the Tag/IdeaTag shape, deliberately.

// A dimension of decomposition — Mechanic, Setting, Tone, Material. Global to
// the user rather than scoped to a kind of concept, so that `space` under
// Setting means the same thing whether the concept is a game or a story. If
// axes were per-kind the vocabulary would fracture along exactly the seam the
// feature exists to see across.
model Axis {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String? // optional hex override; otherwise derived from name
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  components Component[]
  concepts   ConceptAxis[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, order])
}

// A reusable piece of a concept, living on exactly one axis. `description` is a
// deliberately short one-liner shown inline in the combobox; anything longer
// belongs in contentJson.
//
// The unique is [userId, name], not [userId, axisId, name] — matching Tag. One
// name means one component across the whole vocabulary, so a component cannot
// be silently duplicated by filing it under a different axis.
model Component {
  id          String   @id @default(cuid())
  userId      String
  axisId      String
  name        String // normalized lowercase
  description String? // short one-liner
  contentJson String? // ProseMirror JSON for longer notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  axis     Axis               @relation(fields: [axisId], references: [id], onDelete: Cascade)
  concepts ConceptComponent[]

  @@unique([userId, name])
  @@index([userId])
  @@index([axisId])
}

// Which axes this concept declares. Exists solely so that "no components on
// this axis" and "this axis does not apply here" are different states:
//
//   row present, no components  -> declared gap. Rendered as an amber dashed
//                                  slot. This is the nag.
//   no row                      -> not applicable. Rendered as nothing, and
//                                  never scored as incomplete.
//
// Without this table a fiction concept would look permanently unfinished for
// having no Mechanic, and the forcing function becomes a lie. Do not fold this
// into ConceptComponent as an optimisation.
model ConceptAxis {
  ideaId String
  axisId String
  order  Int    @default(0)

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  axis Axis @relation(fields: [axisId], references: [id], onDelete: Cascade)

  @@id([ideaId, axisId])
  @@index([axisId])
}

// The attachment itself. Invariant enforced in the mutation layer: attaching a
// component always ensures a ConceptAxis row for that component's axis, so a
// component can never render under an axis the concept doesn't declare.
model ConceptComponent {
  ideaId      String
  componentId String
  order       Int    @default(0)

  idea      Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([ideaId, componentId])
  @@index([componentId])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String // normalized lowercase
  color     String? // optional hex override; otherwise derived from name
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards CardTag[]
  ideas IdeaTag[]

  @@unique([userId, name])
  @@index([userId])
}

model CardTag {
  cardId String
  tagId  String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@index([tagId])
}

model IdeaTag {
  ideaId String
  tagId  String

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ideaId, tagId])
  @@index([tagId])
}

model ProjectShare {
  id               String   @id @default(cuid())
  projectId        String
  sharedWithUserId String
  pinnedToBoard    Boolean  @default(false)
  priority         Int      @default(1)
  omnipresent      Boolean  @default(true)
  createdAt        DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sharedWith User    @relation("sharedProjects", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([projectId])
}
