// Overboard Organizer schema
// User accounts are isolated by default. Projects can be shared via ProjectShare.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Lane {
  BACKLOG
  TODO
  DOING
  DONE
  FAILED
}

enum ScheduleMode {
  ALWAYS
  NEVER
  CLASS
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  createdAt        DateTime @default(now())
  failedWindowDays Int      @default(7)

  sessions       Session[]
  projects       Project[]
  ideas          Idea[]
  tokens         Token[]
  tags           Tag[]
  classes        ProjectClass[]
  sharedProjects ProjectShare[] @relation("sharedProjects")
  assignedCards  Card[]         @relation("assignedCards")
}

// A reusable named schedule ("class") that marks a project active/inactive by
// hour. Built-in ALWAYS/NEVER modes are virtual (no row here) — a
// ProjectClass row only backs ScheduleMode.CLASS. `windows` is a JSON-encoded
// ScheduleWindow[] (see src/lib/board/schedule.ts for the shape/validation).
model ProjectClass {
  id        String   @id @default(cuid())
  userId    String
  name      String
  tz        String // IANA zone
  windows   String // JSON array of ScheduleWindow
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]      @relation("projectScheduleClass")
  shares   ProjectShare[] @relation("shareScheduleClass")

  @@unique([userId, name])
  @@index([userId])
}

model Token {
  id         String    @id @default(cuid())
  userId     String
  hash       String    @unique
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id           String       @id @default(cuid())
  userId       String
  name         String
  priority     Int          @default(1) // lower = higher in list; can be 0 or negative
  archived     Boolean      @default(false)
  scheduleMode ScheduleMode @default(ALWAYS)
  classId      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  class  ProjectClass?  @relation("projectScheduleClass", fields: [classId], references: [id], onDelete: SetNull)
  cards  Card[]
  shares ProjectShare[]

  @@index([userId])
  @@index([userId, priority])
  @@index([classId])
}

model Card {
  id          String    @id @default(cuid())
  projectId   String
  lane        Lane
  order       Int
  title       String
  contentJson String? // ProseMirror JSON from TipTap
  contentMd   String? // Markdown export
  assigneeId  String?
  dueAt       DateTime?
  expires     Boolean   @default(false)
  failedAt    DateTime?
  rescuedAt   DateTime?
  doneAt      DateTime?
  recurrence  String?
  seriesId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?    @relation("assignedCards", fields: [assigneeId], references: [id], onDelete: SetNull)
  tags     CardTag[]

  @@index([projectId])
  @@index([projectId, lane, order])
  @@index([assigneeId])
  @@index([dueAt])
}

model Idea {
  id          String   @id @default(cuid())
  userId      String
  order       Int
  title       String
  contentJson String?
  contentMd   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags IdeaTag[]

  @@index([userId])
  @@index([userId, order])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String // normalized lowercase
  color     String? // optional hex override; otherwise derived from name
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards CardTag[]
  ideas IdeaTag[]

  @@unique([userId, name])
  @@index([userId])
}

model CardTag {
  cardId String
  tagId  String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@index([tagId])
}

model IdeaTag {
  ideaId String
  tagId  String

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ideaId, tagId])
  @@index([tagId])
}

model ProjectShare {
  id               String       @id @default(cuid())
  projectId        String
  sharedWithUserId String
  pinnedToBoard    Boolean      @default(false)
  priority         Int          @default(1)
  scheduleMode     ScheduleMode @default(ALWAYS)
  classId          String?
  createdAt        DateTime     @default(now())

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sharedWith User          @relation("sharedProjects", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  class      ProjectClass? @relation("shareScheduleClass", fields: [classId], references: [id], onDelete: SetNull)

  @@unique([projectId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([projectId])
  @@index([classId])
}
